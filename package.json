{
  "name": "event-manager-playwright",
  "version": "1.0.0",
  "description": "Interview-ready Playwright QA Automation Framework for College Events & Student Connect Platform",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headless": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --grep @api",
    "test:e2e": "playwright test --grep @e2e",
    "test:student": "playwright test --grep @student",
    "test:admin": "playwright test --grep @admin",
    "test:negative": "playwright test --grep @negative",
    "test:functional": "playwright test --grep @functional",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "qa-automation",
    "e2e-testing",
    "api-testing",
    "page-object-model",
    "javascript"
  ],
  "author": "QA Automation Engineer",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "dotenv": "^16.4.7"
  }
}
